{
  "name": "a3i",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "athreei": "./dist/index.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "bun build src/index.tsx --outdir dist --target node",
    "dev": "bun --watch src/index.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@athreei/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "commander": "^14.0.2",
    "ink": "^6.6.0",
    "ink-spinner": "^5.0.0",
    "ink-select-input": "^6.2.0",
    "open": "^11.0.0",
    "react": "^19.2.3",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/bun": "^1.3.5",
    "@types/react": "^19.2.7",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
