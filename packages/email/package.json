{
  "name": "@athreei/email",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./templates": {
      "import": "./dist/templates/index.js",
      "types": "./dist/templates/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "email:dev": "email dev --port 3030"
  },
  "dependencies": {
    "@react-email/components": "^0.0.31",
    "react": "^19.0.0",
    "resend": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "react-email": "^3.0.4",
    "typescript": "^5.7.2"
  }
}
