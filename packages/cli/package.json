{
  "name": "@athreei/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "a3i": "./dist/index.js"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "build:binary": "bun build src/index.ts --compile --outfile a3i",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "@inquirer/prompts": "^7.2.1",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@athreei/shared": "workspace:*",
    "@noble/ciphers": "^1.0.0",
    "@noble/hashes": "^1.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
