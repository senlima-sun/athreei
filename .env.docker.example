# Docker Development Environment Variables
# Copy this file to .env.docker and customize as needed
# Usage: docker compose -f docker-compose.dev.yml --env-file .env.docker up

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=athreei

# API Server
API_PORT=3001
DATABASE_URL=postgres://postgres:postgres@postgres:5432/athreei
CORS_ORIGINS=http://localhost:3000
BETTER_AUTH_SECRET=dev-secret-change-in-production-minimum-32-chars
BETTER_AUTH_URL=http://localhost:3001

# Platform (Next.js)
PLATFORM_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# Optional: Email (for local testing with Resend)
# RESEND_API_KEY=re_xxxxx
# EMAIL_FROM=noreply@localhost
