{
  "name": "@athreei/native-host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build ./src/index.ts --compile --minify --sourcemap --outfile ./dist/athreei-host",
    "build:macos": "bun build ./src/index.ts --compile --minify --target=bun-darwin-arm64 --outfile ./dist/athreei-host-macos-arm64 && bun build ./src/index.ts --compile --minify --target=bun-darwin-x64 --outfile ./dist/athreei-host-macos-x64",
    "build:windows": "bun build ./src/index.ts --compile --minify --target=bun-windows-x64 --outfile ./dist/athreei-host-windows.exe",
    "build:linux": "bun build ./src/index.ts --compile --minify --target=bun-linux-x64 --outfile ./dist/athreei-host-linux",
    "build:all": "bun run build:macos && bun run build:windows && bun run build:linux",
    "dev": "bun run --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@athreei/shared": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "vitest": "^2.1.8"
  }
}
