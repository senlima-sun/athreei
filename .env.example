# =============================================================================
# athreei Local Development Environment
# =============================================================================
# Copy to .env and customize.
#
# This root .env is loaded when running commands from the monorepo root:
#   - bun db:migrate (database migrations)
#   - bun db:generate (schema generation)
#   - bun db:studio (Drizzle Studio)
#
# For Docker development, use .env.docker.example instead.
#
# Quick setup: cp apps/api/.env .env (if apps/api/.env already configured)
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# Used by: apps/api, packages/db (migrations), packages/sync-server
# For SQLite: DATABASE_URL=file:./data.db
DATABASE_URL=postgres://postgres:postgres@localhost:5432/athreei

# -----------------------------------------------------------------------------
# API Server (apps/api)
# -----------------------------------------------------------------------------
PORT=3001
HOST=localhost
CORS_ORIGINS=http://localhost:3000

# Better Auth - generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-key-change-in-production
BETTER_AUTH_URL=http://localhost:3001

# Encryption key for sensitive data - generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Email (Resend)
# -----------------------------------------------------------------------------
# Used by: apps/api (via @athreei/email package)
# Get your API key at https://resend.com
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com

# -----------------------------------------------------------------------------
# Sync Server (packages/sync-server) - Optional
# -----------------------------------------------------------------------------
# Only needed if running sync-server locally
# Uses same DATABASE_URL as above, or set SYNC_DATABASE_URL for separate DB
# SYNC_DATABASE_URL=postgres://postgres:postgres@localhost:5432/athreei_sync
SYNC_PORT=3002
JWT_SECRET=your-jwt-secret-change-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# -----------------------------------------------------------------------------
# Platform (apps/platform) - Next.js
# -----------------------------------------------------------------------------
# Note: Next.js requires .env.local in apps/platform directory
# Only NEXT_PUBLIC_* vars are used, configured in apps/platform/.env.local
# NEXT_PUBLIC_API_URL=http://localhost:3001
